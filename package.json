{
  "name": "safak-savasci",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0 --port 5000",
    "dev:server": "tsx server/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "warroom:weapons:compress": "node --import tsx scripts/compress-war-room-weapon-models.mjs",
    "warroom:weapons:inspect": "node scripts/analyze-war-room-weapons.mjs",
    "warroom:e2e": "node scripts/war-room-mobile-e2e.mjs",
    "warroom:layout:e2e": "node scripts/war-room-layout-e2e.mjs",
    "warroom:benchmark": "node scripts/war-room-benchmark.mjs",
    "warroom:resource-leak:e2e": "node scripts/war-room-resource-leak-e2e.mjs",
    "warroom:final:e2e": "node scripts/war-room-final-11-9-e2e.mjs",
    "build": "vite build",
    "android:validate:web": "node scripts/validate-android-web.mjs",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "test": "node --import tsx --test --test-concurrency=4 $(find db server src -type f \\( -name '*.test.js' -o -name '*.test.ts' -o -name '*.spec.js' -o -name '*.spec.ts' -o -name '*.test.mjs' -o -name '*.spec.mjs' \\) -print)",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@clerk/localizations": "^4.23.0",
    "@clerk/react": "^6.17.8",
    "@clerk/shared": "^4.40.0",
    "@clerk/themes": "^2.4.57",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@replit/vite-plugin-cartographer": "^0.5.21",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chokidar": "^4.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fast-glob": "^3.3.3",
    "framer-motion": "^14.2.0",
    "howler": "^2.2.4",
    "http-proxy-middleware": "^3.0.7",
    "meshoptimizer": "^1.1.1",
    "pg": "^8.23.1",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
